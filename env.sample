# --- shared MySQL (expense-api / urlshortener-api / contact-app) ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_EXPENSE_DB=expense_db
MYSQL_EXPENSE_USER=expense_app
MYSQL_EXPENSE_PASSWORD=change_me_expense
MYSQL_SHORTENER_DB=shortener_db
MYSQL_SHORTENER_USER=shortener_app
MYSQL_SHORTENER_PASSWORD=change_me_shortener
MYSQL_CONTACT_DB=contact_db
MYSQL_CONTACT_USER=contact_app
MYSQL_CONTACT_PASSWORD=change_me_contact

# --- todo-api (Go) ---
TODO_API_PORT=8080
TODO_DB_PATH=/data/todo.db

# --- expense-api (Rails) ---
EXPENSE_API_PORT=3000
RAILS_ENV=production
# ruby -rsecurerandom -e "puts SecureRandom.hex(64)" で生成した値に変更すること
SECRET_KEY_BASE=change_me_run_ruby_securerandom_hex_64_to_generate

# --- urlshortener-api (PHP) ---
SHORTENER_BASE_URL=http://localhost/s
